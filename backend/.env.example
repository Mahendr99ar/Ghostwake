# Copy to backend/.env for local runs. Never commit the real file.

# Local: SQLite file next to the code. Production: your Neon connection string, e.g.
# GW_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
GW_DATABASE_URL=sqlite:///./ghostwake.db

# Long random string. Analysts paste it once per browser session to review alerts.
GW_ANALYST_TOKEN=change-me

# Comma-separated list of sites allowed to call the API.
GW_CORS_ORIGINS=http://localhost:5173

# Optional language model for the copilot (any OpenAI-compatible endpoint).
# Leave empty to use the offline briefing writer.
GW_LLM_BASE_URL=
GW_LLM_API_KEY=
GW_LLM_MODEL=
